# Screenfin — copy to .env. Two lines are required, PORT is set for a proxy on
# this host, and everything else has a default, shown commented out.
# The comments explain each one.

# Your Jellyfin, as the CONTAINER reaches it (a LAN address, never localhost).
JELLYFIN_URL=http://192.168.1.10:8096

# The hostname your reverse proxy serves Screenfin on, with TLS.
APP_DOMAIN=screenfin.example.com

# Host port your proxy forwards to, with the address it listens on. Loopback is
# right for a proxy on this host. Plain 8484 (also what an unset PORT means)
# listens on every interface — needed for televisions on a ws:// LAN address.
PORT=127.0.0.1:8484

# REQUIRED whenever a reverse proxy is in front: the proxy's address or CIDR as
# the container sees it. Left false, every client arrives as the proxy, and the
# relay's per-address limits lock everyone out at once. A proxy on this host
# reaching the loopback port arrives from the Compose network's gateway:
#   docker network inspect screenfin_default -f '{{(index .IPAM.Config 0).Gateway}}'
# A proxy container on a shared network: its address, or that network's subnet.
# Trust the gateway only while PORT stays on 127.0.0.1. Numeric hop counts are
# rejected and `true` trusts anyone; never use either.
# TRUST_PROXY=172.18.0.1

# Only when the APP_DOMAIN derivation is not the truth (plain http, or a LAN
# ws:// address for televisions). Take a fresh branding mark after changing.
# ALLOWED_ORIGINS=https://screenfin.example.com
# ADVERTISED_URLS=wss://screenfin.example.com/v1/ws,ws://192.168.1.20:8484/v1/ws

# Largest party the relay accepts (1–100).
# MAX_ROOM_PARTICIPANTS=16

# The container's memory ceiling; past it the container restarts, not the host.
# MEM_LIMIT=512m

# Pin a release (the screenfin-server tags); unset follows every release.
# SCREENFIN_VERSION=latest
