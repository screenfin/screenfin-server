{
  "name": "screenfin-server",
  "version": "1.1.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "generate:schemas": "pnpm --filter @screenfin/protocol generate:schemas"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.64.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
